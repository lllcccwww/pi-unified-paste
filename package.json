{
  "name": "pi-workflow-tools",
  "version": "0.3.0",
  "private": true,
  "description": "Configure Pi's default model and paste clipboard content with a single shortcut.",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "clipboard", "models"],
  "scripts": { "test": "node --test" },
  "dependencies": { "koffi": "3.3.6" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "pi": {
    "extensions": ["./src/default-model.ts", "./src/index.ts"]
  }
}
